{
  "name": "cureka-backend",
  "version": "1.0.0",
  "description": "Cureka Backend - Production-grade NestJS modular monolith",
  "author": "Cureka",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "npm run manufacturer:setup && nest start --watch",
    "dev:clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && nest build && nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migration:new": "node scripts/new-migration.js",
    "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d apps/api/database/data-source.ts",
    "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d apps/api/database/data-source.ts",
    "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d apps/api/database/data-source.ts",
    "migration:create": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:create",
    "seed:run": "ts-node -r tsconfig-paths/register apps/api/database/seeds/seed.runner.ts",
    "product:cleanup": "ts-node -r tsconfig-paths/register apps/api/database/scripts/product-cleanup.runner.ts",
    "manufacturer:reset": "ts-node -r tsconfig-paths/register apps/api/database/scripts/manufacturer-reset.runner.ts",
    "manufacturer-address:import": "ts-node -r tsconfig-paths/register apps/api/database/scripts/manufacturer-address-import.runner.ts",
    "manufacturer:setup": "ts-node -r tsconfig-paths/register apps/api/database/scripts/manufacturer-setup.runner.ts",
    "typesense:reindex": "npm run build && node dist/apps/api/database/scripts/typesense-reindex.runner.js",
    "redis:dev": "docker compose -f docker-compose.dev.yml up redis -d",
    "db:dev": "docker compose -f docker-compose.dev.yml up -d"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/multipart": "^8.3.1",
    "@fastify/static": "^7.0.4",
    "@google-cloud/storage": "^7.21.0",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/cache-manager": "^2.3.0",
    "@nestjs/common": "^10.4.1",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.1",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-fastify": "^10.4.1",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/typeorm": "^10.0.2",
    "adm-zip": "^0.5.18",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.13.2",
    "cache-manager": "^5.7.6",
    "cache-manager-ioredis-yet": "^2.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "^4.4.0",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "joi": "^17.13.3",
    "nestjs-pino": "^4.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.2.2",
    "razorpay": "^2.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "typesense": "^3.0.6",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.1",
    "@types/adm-zip": "^0.5.8",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.5.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "(apps|packages|modules)/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "apps/**/*.(t|j)s",
      "packages/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@config/(.*)$": "<rootDir>/apps/api/config/$1",
      "^@common/(.*)$": "<rootDir>/apps/api/common/$1",
      "^@database/(.*)$": "<rootDir>/apps/api/database/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@packages/database$": "<rootDir>/packages/database/src/index",
      "^@packages/database/(.*)$": "<rootDir>/packages/database/src/$1",
      "^@packages/queue$": "<rootDir>/packages/queue/src/index",
      "^@packages/queue/(.*)$": "<rootDir>/packages/queue/src/$1",
      "^@packages/cache$": "<rootDir>/packages/cache/src/index",
      "^@packages/cache/(.*)$": "<rootDir>/packages/cache/src/$1",
      "^@packages/events$": "<rootDir>/packages/events/src/index",
      "^@packages/events/(.*)$": "<rootDir>/packages/events/src/$1",
      "^@packages/logger$": "<rootDir>/packages/logger/src/index",
      "^@packages/logger/(.*)$": "<rootDir>/packages/logger/src/$1",
      "^@packages/common$": "<rootDir>/packages/common/src/index",
      "^@packages/common/(.*)$": "<rootDir>/packages/common/src/$1",
      "^@packages/storage$": "<rootDir>/packages/storage/src/index",
      "^@packages/storage/(.*)$": "<rootDir>/packages/storage/src/$1",
      "^@packages/auth$": "<rootDir>/packages/auth/src/index",
      "^@packages/auth/(.*)$": "<rootDir>/packages/auth/src/$1"
    }
  }
}
