{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "5.0",
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "strict": true,
    "paths": {
      "@config/*": ["apps/api/config/*"],
      "@common/*": ["apps/api/common/*"],
      "@database/*": ["apps/api/database/*"],
      "@modules/*": ["modules/*"],
      "@packages/database": ["packages/database/src/index"],
      "@packages/database/*": ["packages/database/src/*"],
      "@packages/queue": ["packages/queue/src/index"],
      "@packages/queue/*": ["packages/queue/src/*"],
      "@packages/cache": ["packages/cache/src/index"],
      "@packages/cache/*": ["packages/cache/src/*"],
      "@packages/events": ["packages/events/src/index"],
      "@packages/events/*": ["packages/events/src/*"],
      "@packages/logger": ["packages/logger/src/index"],
      "@packages/logger/*": ["packages/logger/src/*"],
      "@packages/common": ["packages/common/src/index"],
      "@packages/common/*": ["packages/common/src/*"],
      "@packages/storage": ["packages/storage/src/index"],
      "@packages/storage/*": ["packages/storage/src/*"]
    }
  }
}
