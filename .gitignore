# Dependencies
node_modules/
/.pnp
.pnp.js

# Build
/dist
/build

# Environment
.env
.env.local
.env.*.local

# Deploy metadata on the VM (lock pointers / history / last-deploy.log)
.deployments/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
/coverage

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# TypeScript
*.tsbuildinfo

# Uploaded files (local storage)
/uploads/**
!/uploads/.gitkeep

# Sitemap audit exports (local CLI output)
/reports/sitemap-audit/

# Product media backfill / harvest run reports
/reports/product-media-backfill/
/reports/product-image-harvest/

# GCS service account credentials (never commit)
/secrets/**
!/secrets/.gitkeep

# GoKwik test session tokens (minted by gokwik:test-credentials)
docs/gokwik-test-credentials.json

# WP image harvest resume cache (mapping xlsx is kept)
docs/wp-image-harvest-cache.json
docs/wp-image-harvest-cache.json.tmp
