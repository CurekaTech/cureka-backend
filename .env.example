RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
# Optional: defaults to 4320 (3 days / 72 hours) in minutes. Set to 15 for 15-minute expiry.
RAZORPAY_PAYMENT_LINK_EXPIRY_MINUTES=4320
# Frontend URL where the user is redirected after payment (e.g. http://localhost:5173/payment-callback)
RAZORPAY_CALLBACK_URL=
# Backend webhook url endpoint registered on Razorpay console
RAZORPAY_WEBHOOK_URL=

CASHFREE_APP_ID=cf_test_replace_me
CASHFREE_SECRET_KEY=replace_me
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01
CASHFREE_WEBHOOK_SECRET=replace_me

