# Logging — nestjs-pino JSON to stdout (Cloud Logging compatible).
# Omit to use defaults: development=debug, production/staging=info, test=silent.
# LOG_LEVEL=info

RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
# Optional: defaults to 4320 (3 days / 72 hours) in minutes. Set to 15 for 15-minute expiry.
RAZORPAY_PAYMENT_LINK_EXPIRY_MINUTES=4320
# Frontend URL where the user is redirected after payment (e.g. http://localhost:5173/payment-callback)
RAZORPAY_CALLBACK_URL=
# Backend webhook url endpoint registered on Razorpay console
RAZORPAY_WEBHOOK_URL=

CASHFREE_APP_ID=cf_test_replace_me
CASHFREE_SECRET_KEY=replace_me
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01
CASHFREE_WEBHOOK_SECRET=replace_me
# Optional override for subscription/membership Cashfree return_url.
# If unset, uses STOREFRONT_URL/cart?order_id={order_id} (same as checkout).
# CASHFREE_RETURN_URL=https://your-storefront.example.com/cart?order_id={order_id}

# Required outside local development. GoKwik callbacks send x-gokwik-callback-secret.
GOKWIK_CALLBACK_SECRET=
GOKWIK_CALLBACK_AUTH_REQUIRED=false

# Outbound GoKwik API client (merchant → GoKwik)
GOKWIK_BASE_URL=
GOKWIK_APP_ID=
GOKWIK_APP_SECRET=
GOKWIK_MERCHANT_ID=
GOKWIK_TIMEOUT_MS=15000
# Product/collection sync to GoKwik (POST /v3/product/update-product-details + /v3/collection/update-collection).
# Must be true for incremental listeners and POST /api/v1/gokwik/admin/catalog/backfill.
GOKWIK_CATALOG_SYNC_ENABLED=false
GOKWIK_ORIGIN_CITY=
GOKWIK_ORIGIN_STATE=
GOKWIK_ORIGIN_PINCODE=
GOKWIK_ORIGIN_COUNTRY=India

# Keep disabled until GoKwik supplies and validates the exact HMAC contract.
GOKWIK_WEBHOOK_ENABLED=false
GOKWIK_WEBHOOK_SECRET=

# KwikPass token decryption is server-side only.
KWIKPASS_ENVIRONMENT=sandbox
KWIKPASS_MERCHANT_ID=
KWIKPASS_JWE_SECRET=
KWIKPASS_JWE_ISSUER=
KWIKPASS_JWE_AUDIENCE=

# BOB / BusinessOnBot — guest key from BOB support (x-guest-id)
# Inbound: they call /api/v1/bob/* with x-guest-id
# Outbound: we POST {BOB_NOTIFY_URL}/orders-create with x-guest-id + X-API-Key (same guest key)
# Do NOT set WHATSAPP_* / WHATSAPP_SEND_URL — Cureka never calls /wabiz/send
# Note: customstore.bonb.io returns 401 "Missing X-API-Key" if X-API-Key is omitted
BOB_GUEST_ID=replace_me
BOB_API_KEY=replace_me
BOB_AUTH_REQUIRED=false
BOB_NOTIFY_URL=
BOB_TIMEOUT_MS=15000

# Public storefront origin used for GoKwik thank-you redirects.
# Used for GoKwik thankyou_redirect_url: {STOREFRONT_URL}/order/confirmation?order_id=...
# techbv: https://cureka.techbv.in | beta: https://beta.cureka.com
STOREFRONT_URL=https://your-storefront.example.com
# Browser/session settings used by the deployed storefront.
CORS_ORIGINS=https://your-storefront.example.com
COOKIE_SECURE=true

# Sitemap generation (BullMQ worker + GCS/local XML). Loc origin defaults to STOREFRONT_URL.
SITEMAP_ENABLED=true
SITEMAP_BASE_URL=https://www.cureka.com
SITEMAP_BATCH_SIZE=10000
SITEMAP_MAX_URLS_PER_FILE=50000
SITEMAP_DEBOUNCE_MS=60000
SITEMAP_REGENERATION_INTERVAL=3600
SITEMAP_STORAGE_PATH=sitemaps
SITEMAP_FORCE_FULL_REBUILD=false

# OTP send rate limits (15-minute window by default)
OTP_MOBILE_MAX_REQUESTS=5
OTP_IP_MAX_REQUESTS=60
OTP_RATE_LIMIT_WINDOW_SECONDS=900
OTP_RESEND_COOLDOWN_SECONDS=60

# Shipway order fulfillment. Docker production requires these credentials.
SHIPWAY_REQUIRED=true
SHIPWAY_EMAIL=replace_me
SHIPWAY_LICENSE_KEY=replace_me
SHIPWAY_BASE_URL=https://app.shipway.com
# Classic getOrderShipmentDetails host (not app.shipway.com)
SHIPWAY_TRACKING_BASE_URL=https://shipway.in
SHIPWAY_WAREHOUSE_ID=
SHIPWAY_RETURN_WAREHOUSE_ID=
SHIPWAY_CARRIER_ID=
# Optional HMAC for single-event webhooks. Classic status_feed uses md5(email:license_key).
# Required in production when Shipway does not send body hash (fail-closed).
SHIPWAY_WEBHOOK_SECRET=
# Prefer DB shipment details when last sync is fresher than this (ms). Default 15m.
SHIPWAY_WEBHOOK_FRESH_MS=900000
SHIPWAY_TIMEOUT_MS=15000
SHIPWAY_DEFAULT_WEIGHT_GRAMS=500
SHIPWAY_DEFAULT_LENGTH_CM=10
SHIPWAY_DEFAULT_BREADTH_CM=10
SHIPWAY_DEFAULT_HEIGHT_CM=5

# MSG91 SMS — https://docs.msg91.com/sms/send-sms (Flow)
# Template IDs, DLT ID, sender, vars → apps/api/config/msg91.constants.ts
MSG91_ENABLED=false
MSG91_AUTH_KEY=replace_me

# Product bulk upload
PRODUCT_BULK_UPLOAD_MAX_SHEET_SIZE=41943040
PRODUCT_BULK_UPLOAD_LOCK_TTL_MS=1800000

# Outbound order push — Unicommerce official tenant API (OAuth 2.0)
# Auth: GET https://{UNICOMMERCE_TENANT}.unicommerce.com/oauth/token
# Order: POST https://{UNICOMMERCE_TENANT}.unicommerce.com/services/rest/v1/oms/saleOrder/create
UNICOMMERCE_ORDER_PUSH_ENABLED=false
UNICOMMERCE_TENANT=stgcureka
UNICOMMERCE_CHANNEL=CUSTOM
UNICOMMERCE_ORDER_CURRENCY=INR
UNICOMMERCE_ORDER_TIMEOUT_MS=15000

# Optional immediate product push. Endpoint must be supplied by UniCommerce.
# Pull catalog endpoints continue working when this is disabled.
UNICOMMERCE_PRODUCT_PUSH_ENABLED=false
UNICOMMERCE_PRODUCT_PUSH_BASE_URL=https://genericproxy.unicommerce.com
UNICOMMERCE_PRODUCT_PUSH_ENDPOINT=
UNICOMMERCE_PRODUCT_PUSH_TIMEOUT_MS=15000

