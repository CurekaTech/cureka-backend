# MCP (analysis agent) credentials — copy to .env.mcp (gitignored) and load
# before starting Claude Code:
#
#   set -a; source .env.mcp; set +a; claude
#
# Every value here must point at a READ-ONLY identity. See docs/mcp/SETUP.md.

# ── GCP ───────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=cureka-501005
# Read-only service account created by scripts/mcp/setup-gcp-readonly.sh.
# gcloud-mcp impersonates it; your own user only needs
# roles/iam.serviceAccountTokenCreator on this SA.
MCP_GCP_SERVICE_ACCOUNT=mcp-readonly@cureka-501005.iam.gserviceaccount.com

# ── Google Analytics 4 / Search Console ───────────────────────────────────
# Leave empty to use Application Default Credentials created with:
#   gcloud auth application-default login \
#     --impersonate-service-account=$MCP_GCP_SERVICE_ACCOUNT \
#     --scopes=https://www.googleapis.com/auth/cloud-platform,https://www.googleapis.com/auth/analytics.readonly,https://www.googleapis.com/auth/webmasters.readonly
# Only set a key-file path if your org allows SA keys; never commit it.
MCP_GOOGLE_CREDENTIALS=
MCP_GSC_CREDENTIALS=
# GA4 property id (numbers only) — passed to the agent, not the server.
GA4_PROPERTY_ID=
# Search Console property, e.g. sc-domain:cureka.com
GSC_SITE_URL=sc-domain:cureka.com

# ── Cloud SQL (PostgreSQL) — read-only role from docs/mcp/sql/mcp_readonly_role.sql
MCP_CLOUDSQL_REGION=asia-south1
MCP_CLOUDSQL_INSTANCE=
MCP_CLOUDSQL_DATABASE=
MCP_CLOUDSQL_USER=mcp_readonly
MCP_CLOUDSQL_PASSWORD=
# public | private | psc. "public" works from a laptop through the Cloud SQL
# connector (IAM-authorised, no authorised networks needed).
MCP_CLOUDSQL_IP_TYPE=public

# ── Redis (BullMQ queues + cache) — read-only ACL user, via IAP tunnel ────
# gcloud compute start-iap-tunnel cureka-beta-v 6379 --local-host-port=localhost:16379 --zone asia-south1-c
MCP_REDIS_URL=redis://mcp_readonly:CHANGE_ME@127.0.0.1:16379/0

# ── Cloudflare ────────────────────────────────────────────────────────────
# Cloudflare MCP servers use OAuth (run /mcp in Claude Code and log in with a
# Cloudflare user that has a read-only role). Zone id is for the agent.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
